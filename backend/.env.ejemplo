# Copiar como .env y poner la clave real. El .env NO se sube a GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=hyd_app
DB_PASSWORD=Cambia_Esta_Clave_123
DB_NAME=reservas_hyd

MARGEN=0.20
IVA=0.19
DESCUENTO_MAXIMO=15
NOCHES_MAXIMAS=30

# Páginas que pueden usar la API, separadas por coma.
ORIGENES_PERMITIDOS=http://127.0.0.1:5500,http://localhost:5500

# Login. JWT_SECRETO firma los tokens: póngale un texto largo y aleatorio.
# Para generarlo:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRETO=
JWT_MINUTOS=480
